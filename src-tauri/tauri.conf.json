{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ava2",
  "version": "0.3.0",
  "identifier": "com.ava.ava2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ava2",
        "width": 1420,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/onion-server.exe",
      "resources/onion-sandbox.exe",
      "resources/apps/*/manifest.json",
      "resources/apps/*/main.js"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0MUM0OEM3QUI2QkFBNkMKUldSc3FtdXJ4MGdjeEVTTWx2Ujg2VHJmbUp1RFdzVWFUOU9acXQzZzhpQlRVaCtSNnFzMHVpMzgK",
      "endpoints": [
        "https://github.com/sungatetop/Ava2/releases/latest/download/latest.json"
      ]
    }
  }
}
