{
  "name": "@ava-ai/app-sdk",
  "version": "0.1.0",
  "description": "ava2 AppHost 应用契约（type-only）：AppContext / AgentChannel / manifest 类型。类型单一来源为宿主 src/host/types.ts，本包只发布其声明产物（.d.ts），运行时零依赖。",
  "type": "module",
  "types": "./dist/types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@types/react": "*"
  },
  "keywords": [
    "ava2",
    "apphost",
    "agent",
    "types"
  ],
  "license": "UNLICENSED"
}
